# Permisos minimos para el docker-socket-proxy de tecnativa.
# Ninguna de estas variables es secreta -- son flags de que operaciones de la
# API de Docker deja pasar el proxy, no credenciales. Por eso se versiona.
#
# Ver docs/security.md para el razonamiento completo de cada flag.

# Necesarios para listar/inspeccionar contenedores, logs y stats:
CONTAINERS=1

# Eventos en vivo (altas/bajas de contenedores) -- viene en 1 por defecto, explicito por claridad:
EVENTS=1
PING=1
VERSION=1

# Escritura habilitada solo para start/stop/restart de contenedores, nada mas:
POST=1
ALLOW_START=1
ALLOW_STOP=1
ALLOW_RESTARTS=1

# Todo lo demas explicitamente apagado (minimo privilegio):
IMAGES=0
NETWORKS=0
VOLUMES=0
EXEC=0
BUILD=0
COMMIT=0
SECRETS=0
SWARM=0
NODES=0
SERVICES=0
TASKS=0
AUTH=0
SYSTEM=0
PLUGINS=0
DISTRIBUTION=0
CONFIGS=0
SESSION=0
GRPC=0

ALLOW_PAUSE=0
ALLOW_UNPAUSE=0
