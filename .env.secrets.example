# Copiar a .env.secrets (nunca se versiona).
#
# IMPORTANTE: docker compose interpola "$" incluso dentro de archivos usados con
# env_file: (no es exclusivo de "${...}" en docker-compose.yml/.env). Un hash bcrypt
# trae varios "$" -- si se pega tal cual, compose lo corrompe. Por eso
# ADMIN_PASSWORD_BCRYPT_HASH se genera con scripts/hash-password.sh, que ya devuelve el
# valor escapado ("$$" por cada "$" literal) listo para pegar aqui:
#
#   ./scripts/hash-password.sh 'tu-password'
#
# SESSION_SECRET no tiene este problema (es hex, sin "$"). Generar con:
#   openssl rand -hex 32
ADMIN_PASSWORD_BCRYPT_HASH=
SESSION_SECRET=
